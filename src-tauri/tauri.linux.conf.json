{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "bundle": {
    "targets": [
      "deb"
    ],
    "resources": {
      "rs-delivery-linux": "rs-delivery-linux",
      "rs-delivery-linux.sha256": "rs-delivery-linux.sha256",
      "../dist/": "www/"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "xvfb"
        ],
        "files": {
          "/usr/lib/systemd/user/restreamer.service": "linux/restreamer.service",
          "/usr/lib/systemd/system/restreamer-upgrade.service": "linux/restreamer-upgrade.service",
          "/usr/lib/systemd/system/restreamer-upgrade.timer": "linux/restreamer-upgrade.timer"
        },
        "postInstallScript": "linux/postinst",
        "preRemoveScript": "linux/prerm"
      }
    }
  }
}
